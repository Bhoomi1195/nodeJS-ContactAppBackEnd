{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "typeRoots": [
  "./node_modules/@types",
  "./types"
]
  },
  "include": ["src/**/*"]
}